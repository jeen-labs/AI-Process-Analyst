# =========================================================
# AI Process Analyst
# Git Ignore Rules
# =========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# -------------------------
# Virtual Environments
# -------------------------
venv/
.venv/
env/
ENV/

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*

# -------------------------
# IDE Settings
# -------------------------
.vscode/
.idea/

# -------------------------
# Operating System Files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Python Testing
# -------------------------
.pytest_cache/
.coverage
htmlcov/

# -------------------------
# Build & Distribution
# -------------------------
build/
dist/
*.egg-info/

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Jupyter Notebooks
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.bak
*.swp

# -------------------------
# Generated Reports (optional)
# Uncomment if reports are generated automatically
# reports/
# output/
# generated/