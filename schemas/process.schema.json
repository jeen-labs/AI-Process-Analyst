{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://github.com/jeen-labs/AI-Process-Analyst/schemas/process.schema.json",

  "title": "Enterprise Process Schema",

  "description": "Canonical enterprise process model used throughout the AI Process Analyst platform.",

  "type": "object",

  "required": ["metadata", "overview", "activities"],

  "properties": {
    "metadata": {
      "type": "object",

      "description": "Core identifying information for the business process.",

      "required": [
        "process_id",
        "process_name",
        "process_level",
        "version",
        "status",
        "schema_version"
      ],

      "properties": {
        "process_id": {
          "type": "string",
          "pattern": "^PROC-.+",
          "description": "Unique identifier for the process."
        },

        "process_name": {
          "type": "string",
          "description": "Human-readable name of the process."
        },

        "parent_process": {
          "type": ["string", "null"],
          "description": "Identifier of the parent process, if applicable."
        },

        "previous_process": {
          "type": ["string", "null"],
          "description": "Identifier of the preceding process."
        },

        "next_process": {
          "type": ["string", "null"],
          "description": "Identifier of the succeeding process."
        },

        "process_level": {
          "type": "integer",
          "minimum": 1,
          "description": "Hierarchy level of the process."
        },

        "version": {
          "type": "string",
          "description": "Business version of the process."
        },

        "status": {
          "type": "string",
          "description": "Current lifecycle status of the process.",

          "enum": ["Draft", "Active", "Retired"]
        },

        "created_by": {
          "type": "string",
          "description": "Author or system that created the process definition."
        },

        "created_on": {
          "type": "string",
          "format": "date",
          "description": "Date the process definition was created."
        },

        "schema_version": {
          "type": "string",
          "description": "Canonical schema version used for validation."
        }
      },

      "additionalProperties": false
    },

    "overview": {
      "type": "object",

      "description": "Business overview of the process.",

      "properties": {
        "description": {
          "type": "string",
          "description": "Summary description of the process."
        },

        "objective": {
          "type": "string",
          "description": "Primary business objective of the process."
        },

        "scope": {
          "type": "string",
          "description": "Business scope covered by the process."
        },

        "trigger": {
          "type": "string",
          "description": "Event that initiates the process."
        },

        "end_condition": {
          "type": "string",
          "description": "Condition that signifies successful completion."
        }
      },

      "additionalProperties": false
    },

    "actors": {
      "type": "array",

      "description": "Actors participating in the process.",

      "items": {
        "$ref": "actor.schema.json"
      }
    },

    "systems": {
      "type": "array",

      "description": "Systems supporting the process.",

      "items": {
        "type": "string"
      }
    },

    "documents": {
      "type": "array",

      "description": "Business documents referenced by the process.",

      "items": {
        "type": "string"
      }
    },

    "inputs": {
      "type": "array",

      "description": "Inputs required by the process.",

      "items": {
        "type": "string"
      }
    },

    "outputs": {
      "type": "array",

      "description": "Outputs produced by the process.",

      "items": {
        "type": "string"
      }
    },

    "activities": {
      "type": "array",

      "description": "Activities executed within the process.",

      "items": {
        "$ref": "activity.schema.json"
      }
    },

    "decisions": {
      "type": "array",

      "description": "Decision points within the process.",

      "items": {
        "$ref": "decision.schema.json"
      }
    },

    "business_rules": {
      "type": "array",

      "description": "Business rules governing the process.",

      "items": {
        "$ref": "business_rule.schema.json"
      }
    },

    "risks": {
      "type": "array",

      "description": "Business risks associated with the process.",

      "items": {
        "type": "string"
      }
    },

    "controls": {
      "type": "array",

      "description": "Business controls mitigating identified risks.",

      "items": {
        "type": "string"
      }
    },

    "kpis": {
      "type": "array",

      "description": "Key performance indicators used to measure the process.",

      "items": {
        "type": "string"
      }
    },

    "relationships": {
      "type": "object",

      "description": "Relationships with other enterprise processes.",

      "properties": {
        "previous_process": {
          "type": ["string", "null"],
          "description": "Identifier of the preceding process."
        },

        "next_process": {
          "type": ["string", "null"],
          "description": "Identifier of the succeeding process."
        },

        "subprocesses": {
          "type": "array",

          "description": "Subprocesses belonging to this process.",

          "items": {
            "type": "string"
          }
        }
      },

      "additionalProperties": false
    },

    "source": {
      "type": "object",

      "description": "Source document metadata used during extraction.",

      "properties": {
        "document_name": {
          "type": "string",
          "description": "Name of the source document."
        },

        "document_type": {
          "type": "string",
          "description": "Type of source document."
        },

        "page_numbers": {
          "type": "array",

          "description": "Pages from which information was extracted.",

          "items": {
            "type": "integer"
          }
        },

        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence score assigned to the extracted process."
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
