{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://github.com/jeen-labs/AI-Process-Analyst/schemas/process.schema.json",

  "title": "Enterprise Process Schema",

  "description": "Canonical enterprise process model used throughout the AI Process Analyst platform.",

  "type": "object",

  "required": ["metadata", "overview", "activities"],

  "properties": {
    "metadata": {
      "type": "object",

      "required": [
        "process_id",
        "process_name",
        "process_level",
        "version",
        "status",
        "schema_version"
      ],

      "properties": {
        "process_id": {
          "type": "string"
        },

        "process_name": {
          "type": "string"
        },

        "parent_process": {
          "type": ["string", "null"]
        },

        "previous_process": {
          "type": ["string", "null"]
        },

        "next_process": {
          "type": ["string", "null"]
        },

        "process_level": {
          "type": "integer",
          "minimum": 1
        },

        "version": {
          "type": "string"
        },

        "status": {
          "type": "string",
          "enum": ["Draft", "Active", "Retired"]
        },

        "created_by": {
          "type": "string"
        },

        "created_on": {
          "type": "string"
        },

        "schema_version": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "overview": {
      "type": "object",

      "properties": {
        "description": {
          "type": "string"
        },

        "objective": {
          "type": "string"
        },

        "scope": {
          "type": "string"
        },

        "trigger": {
          "type": "string"
        },

        "end_condition": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "actors": {
      "type": "array",

      "items": {
        "$ref": "actor.schema.json"
      }
    },

    "systems": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "documents": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "inputs": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "outputs": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "activities": {
      "type": "array",

      "items": {
        "$ref": "activity.schema.json"
      }
    },

    "decisions": {
      "type": "array",

      "items": {
        "$ref": "decision.schema.json"
      }
    },

    "business_rules": {
      "type": "array",

      "items": {
        "$ref": "business_rule.schema.json"
      }
    },

    "risks": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "controls": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "kpis": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },

    "relationships": {
      "type": "object",

      "properties": {
        "previous_process": {
          "type": ["string", "null"]
        },

        "next_process": {
          "type": ["string", "null"]
        },

        "subprocesses": {
          "type": "array",

          "items": {
            "type": "string"
          }
        }
      },

      "additionalProperties": false
    },

    "source": {
      "type": "object",

      "properties": {
        "document_name": {
          "type": "string"
        },

        "document_type": {
          "type": "string"
        },

        "page_numbers": {
          "type": "array",

          "items": {
            "type": "integer"
          }
        },

        "confidence_score": {
          "type": "number",

          "minimum": 0,

          "maximum": 1
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
